// Everything in niri's configuration that only this machine can know.
//
// Linked to ~/.config/niri/host.kdl, which the shared config.kdl includes at
// the end. See docs/adr/0005-per-host-dotfiles-through-native-includes.md.

input {
    keyboard {
        xkb {
            layout "gb,gb"
            variant ",intl"
        }
    }
}

binds {
    XF86AudioMute        allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
}

output "DP-3" {
    mode "3440x1440@165.001"
    scale 1
    position x=0 y=1080
    focus-at-startup
    layout {
        always-center-single-column
    }
}

output "HDMI-A-1" {
    mode "1920x1080@120.000"
    scale 1
    position x=771 y=0
}

// Host-specific because they name a connector: these only mean anything on a
// machine that has an HDMI-A-1.
window-rule {
    match title="^Spotify$"
    open-on-output "HDMI-A-1"
}

window-rule {
    match app-id="^discord$"
    open-on-output "HDMI-A-1"
}
