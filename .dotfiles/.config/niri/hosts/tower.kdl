// Everything in niri's configuration that only this machine can know.
//
// Linked to ~/.config/niri/host.kdl, which the shared config.kdl includes at
// the end.

input {
    keyboard {
        xkb {
            layout "gb,gb"
            variant ",intl"
        }
    }
}

output "DP-3" {
    mode "3440x1440@165.001"
    scale 1
    position x=0 y=0
    focus-at-startup
    layout {
        always-center-single-column
    }
}

output "HDMI-A-1" {
    mode "1920x1080@120.000"
    scale 1
    position x=771 y=-1080
}

// The labeled workspaces split across the two monitors: web, code, and the 4
// and 5 spares on the ultrawide, chat and the 6 spare on the side screen.
// Legend in hosts/laptop.kdl.
workspace "\u{F0AC}" { open-on-output "DP-3"; }
workspace "\u{F121}" { open-on-output "DP-3"; }
workspace "4" { open-on-output "DP-3"; }
workspace "5" { open-on-output "DP-3"; }
workspace "\u{F086}" { open-on-output "HDMI-A-1"; }
workspace "6" { open-on-output "HDMI-A-1"; }

// This host also sends the terminal and emacs to code.
window-rule {
    match app-id="^kitty$"
    match app-id="^emacs$"
    open-on-workspace "\u{F121}"
}
